# ==============================================================================
# Environment Variables Example Configuration
# Copy this file to '.env.local' and populate with your credentials.
# Do NOT commit '.env.local' or any other files containing real secrets to VCS.
# ==============================================================================

# Next.js Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configurations (Database, Auth, Storage, Row Level Security)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-use-only-on-server

# Razorpay Payment Gateway Integration
# Obtain these from your Razorpay Dashboard -> Settings -> API Keys (Test / Live mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# SMS & OTP Provider (Twilio Verify API for passwordless phone login)
# Obtain these from your Twilio Console dashboard
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Email SMTP Server Configurations (Notifications and Admin recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@margpharmacy.com
